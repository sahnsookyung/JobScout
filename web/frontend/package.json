{
    "name": "jobscout-dashboard",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run type-check && vite build && npm run check:bundle",
        "check:bundle": "node scripts/check-initial-bundle-size.mjs",
        "preview": "vite preview",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "type-check": "node node_modules/typescript7/bin/tsc --noEmit",
        "test": "vitest",
        "test:coverage": "vitest --coverage",
        "test:ui": "vitest --ui",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@tanstack/react-query": "^5.108.2",
        "axios": "^1.21.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.77.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.65.1",
        "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.13",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.73.0",
        "@typescript-eslint/parser": "^8.73.0",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.1.1",
        "autoprefixer": "^10.7.0",
        "eslint": "^10.15.0",
        "fake-indexeddb": "^6.2.8",
        "jsdom": "^31.0.1",
        "postcss": "^8.5.33",
        "tailwindcss": "^4.3.5",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript7": "npm:typescript@^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "overrides": {
        "follow-redirects": ">=1.16.2",
        "undici@^7": "7.30.2",
        "undici@^8": "8.12.4",
        "tldts": "7.4.22",
        "tldts-core": "7.4.22"
    },
    "engines": {
        "node": "^24.15.0 || >=26.0.0"
    }
}
